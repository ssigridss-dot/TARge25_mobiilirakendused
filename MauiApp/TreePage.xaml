<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.TreePage"
             Title="Puu">
    <Grid RowDefinitions="*,Auto"
          BackgroundColor="LightSkyBlue">

        <AbsoluteLayout
            x:Name="TreeArea"
            Grid.Row="0">

            <BoxView
                Color="ForestGreen"
                AbsoluteLayout.LayoutBounds="0,1,1,0.20"
                AbsoluteLayout.LayoutFlags="All" />

            <BoxView
                x:Name="TreeTrunk"
                Color="SaddleBrown"
                CornerRadius="8"
                AbsoluteLayout.LayoutBounds="0.5,0.72,55,250"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Ellipse
                x:Name="Leaves1"
                Fill="ForestGreen"
                AbsoluteLayout.LayoutBounds="0.50,0.35,190,190"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Ellipse
                x:Name="Leaves2"
                Fill="Green"
                AbsoluteLayout.LayoutBounds="0.32,0.48,160,160"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Ellipse
                x:Name="Leaves3"
                Fill="DarkGreen"
                AbsoluteLayout.LayoutBounds="0.68,0.48,160,160"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Ellipse
                x:Name="Flower1"
                Fill="HotPink"
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="0.42,0.35,25,25"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Ellipse
                x:Name="Flower2"
                Fill="Pink"
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="0.58,0.40,25,25"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Ellipse
                x:Name="Flower3"
                Fill="HotPink"
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="0.50,0.25,25,25"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

        </AbsoluteLayout>

        <ScrollView Grid.Row="1"
                    BackgroundColor="White">

            <VerticalStackLayout
                Padding="15"
                Spacing="10">

                <Label
                    Text="Puu"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="DarkGreen" />

                <Picker
                    x:Name="ActionPicker"
                    Title="Vali tegevus">
                    <Picker.Items>
                        <x:String>Kasva</x:String>
                        <x:String>Õitse</x:String>
                        <x:String>Värise</x:String>
                        <x:String>Langeta</x:String>
                    </Picker.Items>
                </Picker>

                <Button
                    x:Name="ActionButton"
                    Text="Käivita"
                    Clicked="OnActionClicked"
                    BackgroundColor="ForestGreen"
                    TextColor="White" />

                <Label
                    x:Name="StatusLabel"
                    Text="Vali tegevus ja vajuta Käivita."
                    FontSize="16"
                    TextColor="DarkBlue"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Lehestiku läbipaistvus:"
                    FontAttributes="Bold" />

                <Slider
                    x:Name="OpacitySlider"
                    Minimum="0"
                    Maximum="1"
                    Value="1"
                    ValueChanged="OnOpacityChanged" />

                <Label
                    Text="Animatsiooni kiirus:"
                    FontAttributes="Bold" />

                <Stepper
                    x:Name="SpeedStepper"
                    Minimum="500"
                    Maximum="2000"
                    Increment="250"
                    Value="1000" />

                <Label
                    x:Name="SpeedLabel"
                    Text="1000 ms"
                    HorizontalOptions="Center" />

                <Label
                    Text="Virtuaalne kuupäev:"
                    FontAttributes="Bold" />

                <DatePicker
                    x:Name="SeasonPicker"
                    DateSelected="OnDateSelected" />

                <Label
                    Text="Virtuaalne kellaaeg:"
                    FontAttributes="Bold" />

                <TimePicker
                    x:Name="TimeSelector"
                    Time="12:00:00" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>